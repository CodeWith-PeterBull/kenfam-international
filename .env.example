APP_NAME="Kenfam International"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Nairobi

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="info@kenfam.co.ke"
MAIL_FROM_NAME="${APP_NAME}"

# Public Aureon CMS homepage identity and implementation enquiry destination.
AUREON_PRODUCT_NAME="Kenfam International"
AUREON_HOME_ASSET_VERSION=20260908

# Presentation-safe Institution Details fallbacks. The database profile takes precedence.
INSTITUTION_NAME="Kenfam International"
INSTITUTION_SHORT_NAME="Kenfam"
INSTITUTION_FOUNDED_YEAR=1994
INSTITUTION_DESCRIPTOR="Enhancing global connections"
INSTITUTION_EMAIL="${MAIL_FROM_ADDRESS}"
INSTITUTION_SECONDARY_EMAIL=null
INSTITUTION_PHONE="+254 714 884 069"
INSTITUTION_SECONDARY_PHONE=null
INSTITUTION_WEBSITE="${APP_URL}"
INSTITUTION_PHYSICAL_ADDRESS="Purvi House, Wing B, 2nd Floor, Room 202, Westlands"
INSTITUTION_CITY="Nairobi"
INSTITUTION_COUNTY="Nairobi"
INSTITUTION_POSTAL_CODE="00800"
INSTITUTION_POSTAL_ADDRESS="P.O. Box 14350-00800"
INSTITUTION_POSTAL_CITY="Nairobi"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

LOG_VIEWER_ENABLED=true
LOG_VIEWER_API_ONLY=false
LOG_VIEWER_EXCLUDE_IP_FROM_IDENTIFIERS=false

# Two-factor authentication (email OTP) — see config/two-factor.php and
# .docs/auth-2fa/. The subsystem is inert while TWO_FACTOR_ENABLED=false;
# users opt in individually from the profile Security panel once it is on.
# NOTE: OTP mail is queued — a queue worker must run (composer run dev does).
TWO_FACTOR_ENABLED=false
TWO_FACTOR_CODE_LENGTH=6
TWO_FACTOR_CODE_EXPIRY=10
TWO_FACTOR_SESSION_TTL=24
TWO_FACTOR_MAIL_ENABLED=true
# Break-glass bypass accounts (leave blank unless operationally required).
TWO_FACTOR_EXEMPT_EMAIL_1=
TWO_FACTOR_EXEMPT_EMAIL_2=
TWO_FACTOR_EXEMPT_EMAIL_3=

# Optional first-party Commerce module defaults. Prices and totals are stored
# as integer minor units; 1600 basis points represents a 16 percent tax rate.
COMMERCE_ENABLED=false
COMMERCE_CURRENCY_CODE=KES
COMMERCE_CURRENCY_SYMBOL="KSh"
COMMERCE_CURRENCY_DECIMALS=2
COMMERCE_TAX_RATE_BPS=1600
COMMERCE_PRICES_INCLUDE_TAX=true
COMMERCE_ALLOW_OVERSELL=false
COMMERCE_LOW_STOCK_THRESHOLD=5
COMMERCE_PRODUCT_GALLERY_LIMIT=8
COMMERCE_MEDIA_UPLOAD_MAX_KB=5120
COMMERCE_COUNTRY_CODE=KE
COMMERCE_DELIVERY_FEE_MINOR=0
COMMERCE_PAYMENT_METHODS=mobile_money,bank_transfer,cash_on_delivery
COMMERCE_CART_SESSION_KEY=commerce.storefront.cart
COMMERCE_CONFIRMATION_LINK_MINUTES=120
COMMERCE_TRACKING_LINK_DAYS=90
COMMERCE_DOCUMENT_LINK_DAYS=30
COMMERCE_POS_PAYMENT_METHODS=cash,mobile_money,card,bank_transfer
COMMERCE_POS_MAX_TENDERS=4
COMMERCE_POS_PRODUCT_RESULTS=12
COMMERCE_POS_RECEIPT_PRINT_DRIVER=browser
COMMERCE_POS_RECEIPT_PRINT_MODE=manual
COMMERCE_POS_RECEIPT_PAPER_WIDTH_MM=80
COMMERCE_POS_ADD_TO_CART_SOUND=true
COMMERCE_POS_SALES_HISTORY_TERMINAL=true
COMMERCE_POS_SALES_HISTORY_DASHBOARD=true
COMMERCE_POS_SALES_HISTORY_PER_PAGE=8
COMMERCE_WEB_ORDER_PREFIX=WEB
COMMERCE_POS_ORDER_PREFIX=POS
COMMERCE_BARCODE_INTERNAL_PREFIX=MM
COMMERCE_BARCODE_INTERNAL_PAD=10
COMMERCE_BARCODE_LABEL_COLUMNS=3
COMMERCE_BARCODE_LABEL_STORE_NAME=true
COMMERCE_BARCODE_LABEL_PRODUCT_NAME=true
COMMERCE_BARCODE_LABEL_PRICE=true
COMMERCE_BARCODE_LABEL_MAX=300
COMMERCE_STOREFRONT_SHARING_ENABLED=true
COMMERCE_STOREFRONT_SHARING_PLATFORMS=
COMMERCE_STOREFRONT_WHATSAPP_ORDER_ENABLED=true
COMMERCE_OPERATIONAL_NOTIFICATIONS_ENABLED=true
COMMERCE_NOTIFY_WEB_ORDER_PLACED=true
COMMERCE_NOTIFY_PAYMENT_CONFIRMED=true
COMMERCE_NOTIFY_ORDER_READY=true
COMMERCE_NOTIFY_ORDER_CANCELLED=true
COMMERCE_NOTIFY_LOW_STOCK=true
COMMERCE_NOTIFY_OUT_OF_STOCK=true
COMMERCE_NOTIFY_TILL_VARIANCE=true
COMMERCE_TILL_VARIANCE_ALERT_THRESHOLD_MINOR=10000
COMMERCE_NOTIFICATION_QUEUE=default

# Optional first-party Property Booking module. All persisted times are UTC;
