PROPERTY_BOOKING_ENABLED=false
TRAVEL_TOURS_ENABLED=true
TRAVEL_TOURS_COUNTRY_CODE=KE
TRAVEL_TOURS_CURRENCY_CODE=KES
TRAVEL_TOURS_CURRENCY_SYMBOL="KSh"
TRAVEL_TOURS_CURRENCY_DECIMALS=2
TRAVEL_TOURS_TIMEZONE=Africa/Nairobi
