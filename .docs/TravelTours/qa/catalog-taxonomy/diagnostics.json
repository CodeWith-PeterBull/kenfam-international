  "observations": [
    "narrow-dark-categories: at 320 px the document width is 320 for a 320 viewport (host shell responsibility; recorded, not asserted)",
    "category-add-dialog: focus is not moved into the dialog on open (active: body)",
    "category-add-dialog: page behind the dialog still scrolls (body overflow not locked)",
    "category-add: focus escapes the dialog after three Tab presses (no focus trap)",
    "category-validation: an empty submit is intercepted by the browser's native \"required\" tooltip; the form lacks novalidate, so Livewire's inline .invalid-feedback pattern never runs for a blank name (the parent module sets novalidate on its Livewire forms)",
    "category-validation: invalid field carries no aria-invalid attribute",
    "category-validation: error message is not linked via aria-describedby",
    "category-validation: no live region or role=\"alert\" announces the validation error",
    "category-validation: focus is not moved to the first invalid field",
    "destination-search: search and filters are not reflected in the URL, so a filtered view cannot be shared or restored",
